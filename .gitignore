# ---------------------------------------------------------------------------
# Secrets and machine-local configuration — never commit these.
# Database passwords live in %APPDATA%\postgresql\pgpass.conf or environment
# variables (see jtac/docs/adr/0004-database-roles-and-migrations.md).
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pgpass
pgpass.conf
*.pem
*.key
*.p12
*.pfx
*.jks
**/config/secrets/
application-secrets*.yaml
application-secrets*.yml

# OS / editors
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
*.iml
.vscode/*
!.vscode/extensions.json

# Claude Code machine-local settings (shared settings.json may be committed)
.claude/settings.local.json

# Gradle / Java
.gradle/
.kotlin/
build/
out/
*.class
hs_err_pid*.log
!gradle/wrapper/gradle-wrapper.jar

