#!/bin/sh
# JTRAC server command. Usage: jtrac <command> [options]   (jtrac help)
set -e
self="$0"
while [ -h "$self" ]; do
  link=$(ls -ld "$self" | sed 's/.* -> //')
  case "$link" in
    /*) self="$link" ;;
    *) self="$(dirname "$self")/$link" ;;
  esac
done
JTRAC_HOME=$(cd "$(dirname "$self")/.." && pwd -P)
JTRAC_JAVA="$JTRAC_HOME/runtime/bin/java"
if [ ! -x "$JTRAC_JAVA" ]; then
  echo "JTRAC: the bundled Java runtime is missing from $JTRAC_HOME/runtime. The package is incomplete." >&2
  exit 1
fi
exec "$JTRAC_JAVA" -Djtrac.home="$JTRAC_HOME" -Dfile.encoding=UTF-8 -cp "$JTRAC_HOME/lib/launcher/*" com.jtrac.launcher.Launcher "$@"
